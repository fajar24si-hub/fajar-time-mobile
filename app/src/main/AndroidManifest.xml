<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin Internet (sudah ada) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- +++ TAMBAHAN UNTUK PERTEMUAN 13 +++ -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- +++ AKHIR TAMBAHAN +++ -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fajartime"
        tools:targetApi="31">

        <!-- +++ TAMBAHAN PROVIDER UNTUK FILE PROVIDER +++ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- +++ AKHIR TAMBAHAN +++ -->

        <!-- Semua activity yang sudah ada tetap dipertahankan -->
        <activity
            android:name=".Masage.tutorial.TutorialMessageActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_10.TenthActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_9.NinthActivity"
            android:exported="true" />
        <activity
            android:name=".BaseActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_7.SeventhActivity"
            android:exported="false" />
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AuthActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_5.FifthActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_4.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_4.DetailActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_3.SelamatDatangActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_3.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".Home.Pertemuan_2.PerhitunganActivity"
            android:exported="false"
            android:label="Kalkulator Persegi Panjang &amp; Balok" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Fajartime" />

        <!-- +++ TAMBAHAN ACTIVITY PERTEMUAN 13 +++ -->
        <activity
            android:name=".Home.Pertemuan_13.ThirteenthActivity"
            android:exported="false" />
        <!-- +++ AKHIR TAMBAHAN +++ -->

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivLogoTutorial2"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/skillboost_logo_nobg"
        android:contentDescription="SkillBoost Logo"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/tvHintTutorial2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tap gambar untuk melihat detail tutorial 2"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <LinearLayout
        android:id="@+id/layoutDetailTutorial2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetailTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Tutorial 2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/tvDetailMessage2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ini adalah detail untuk tutorial 2"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnReply2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balas"
                style="@style/Widget.Material3.Button.TextButton"/>

            <Button
                android:id="@+id/btnSave2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simpan"
                style="@style/Widget.Material3.Button.TextButton"/>

            <Button
                android:id="@+id/btnShare2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bagikan"
                style="@style/Widget.Material3.Button.TextButton"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>